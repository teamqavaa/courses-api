# Copier en .env.local (docker compose) et compléter. Ne jamais committer les vraies valeurs.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SSO Qavaa : vérification des tokens via le JWKS (core/sso.py)
SSO_ISSUER=https://qavaa-innovate-sso-zlvwvifuvq-ew.a.run.app
# Production : laisser vide pour dériver l'URL depuis SSO_ISSUER.
# SSO_JWKS_URL=https://qavaa-innovate-sso-zlvwvifuvq-ew.a.run.app/o/.well-known/jwks.json
# SSO local dans Docker : le SSO signe avec sa clé locale.
# SSO_JWKS_URL=http://host.docker.internal:8000/o/.well-known/jwks.json

# Uniquement pour l'introspection (core/permissions.py) : application "Confidential" du SSO
SSO_INTROSPECT_URL=https://qavaa-innovate-sso-zlvwvifuvq-ew.a.run.app/o/introspect/
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Piston : exécution du code des labs (voir infrastructure/piston/README.md).
# Depuis le conteneur app de docker compose :
PISTON_URL=http://host.docker.internal:2000
# Hors Docker, utiliser http://localhost:2000 (ou le port choisi avec PISTON_HOST_PORT).

# Production : les valeurs Cloud SQL et le secret Django sont injectés par
# .github/workflows/deploy.yml. PISTON_URL doit aussi être fourni en production
# (il n'est pas encore configuré dans ce workflow).
